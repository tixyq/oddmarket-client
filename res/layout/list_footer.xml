<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/footer_items_container"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/footer_control_panel"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/footer_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="0dp"
                android:focusable="true"
                android:background="@drawable/list_item_selector"
                android:contentDescription="@string/desc_page_prev"
                android:src="@drawable/ic_menu_back" />

            <TextView
                android:id="@+id/footer_page_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"

                android:textSize="15sp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp" />

            <ImageView
                android:id="@+id/footer_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="0dp"
                android:focusable="true"
                android:background="@drawable/list_item_selector"
                android:contentDescription="@string/desc_page_next"
                android:src="@drawable/ic_menu_next" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
